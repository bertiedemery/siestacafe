{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siesta-cafe",
  "main": "dist/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ]
}
